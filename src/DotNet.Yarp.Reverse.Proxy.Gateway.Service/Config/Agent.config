<?xml version="1.0" encoding="utf-8"?>
<Agent>
  <!--
    服务元数据与运行期阈值。这是与 appsettings.json 并列的第二套配置体系：
      Config/Agent.config —— 服务怎么装、怎么自愈（进程级）
      appsettings.json    —— 网关怎么代理、怎么治理（流量级）
    修改本文件后需重启服务生效。

    安全基线：EnableWebPanel=false。Agent 自带的 Web 管理面板默认开启、默认口令 admin/admin、
    额外监听 5580；对公网反向代理而言，多一个默认口令的管理面是纯风险。网关自身已有
    /admin/status 与 /metrics 两个只读端点，需要进程级管理时请临时开启并立即改口令。
  -->
  <ServiceName>YarpGateway</ServiceName>
  <DisplayName>YARP Reverse Proxy Gateway</DisplayName>
  <Description>.NET reverse-proxy gateway (YARP) hosted as a Windows service</Description>

  <!-- Windows 上以系统服务方式运行（false）。true 表示登录桌面后自启动，不适合服务器。 -->
  <UseAutorun>false</UseAutorun>

  <!-- 进程级自愈：超过阈值自动重启。0 表示不限（默认不因内存重启，先观察再收紧）。 -->
  <MaxMemory>0</MaxMemory>
  <MaxThread>1000</MaxThread>
  <MaxHandle>10000</MaxHandle>

  <!-- 健康检查周期与主动内存整理间隔（秒）。 -->
  <WatchInterval>10</WatchInterval>
  <FreeMemoryInterval>600</FreeMemoryInterval>

  <!-- 定时重启：0 表示关闭。开启时配合 RestartTimeRange 落在低峰时段。 -->
  <AutoRestart>0</AutoRestart>
  <RestartTimeRange></RestartTimeRange>

  <!-- 管理面板：默认关闭（见上方安全基线）。如确需开启，必须改 WebPassword 并保持回环绑定。 -->
  <EnableWebPanel>false</EnableWebPanel>
  <WebPort>5580</WebPort>
  <WebBind>127.0.0.1</WebBind>
</Agent>
