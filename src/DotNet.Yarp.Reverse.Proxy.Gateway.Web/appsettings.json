{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "web-route": {
        "ClusterId": "web-cluster",
        "Match": { "Path": "/web/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/web" } ]
      }
    },
    "Clusters": {
      "api-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": { "Enabled": true, "Policy": "Cookie", "AffinityKeyName": ".YarpGatewayAffinity" },
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "api1": { "Address": "http://localhost:5101/" },
          "api2": { "Address": "http://localhost:5102/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "web-cluster": {
        "SessionAffinity": { "Enabled": true, "Policy": "Cookie", "AffinityKeyName": ".YarpGatewayAffinity" },
        "Destinations": {
          "web1": { "Address": "http://localhost:5200/" }
        }
      }
    }
  },

  "Gateway": {
    "RateLimit": { "PerMinute": 600, "Burst": 0, "DelayEnabled": false, "MaxDelayMs": 1000, "PerIp": true, "MaxIpBuckets": 10000, "BucketIdleMinutes": 30 },
    "Cors": { "AllowedOrigins": [ "https://example.com" ] },
    "Auth": {
      "Required": false,
      "Keys": [ "demo-key-1" ],
      "Jwt": {
        "Enabled": false,
        "Secret": "",
        "PublicKeyPem": "",
        "Issuer": "",
        "Audience": "",
        "ClockSkewSeconds": 60,
        "RequireExpiry": true,
        "ClaimsHeader": "X-Jwt-Sub"
      }
    },
    "Cache": { "Enabled": true, "DefaultTtlSeconds": 30, "MaxCacheEntries": 10000, "CacheableStatusCodes": [ 200 ] },
    "Security": {
      "Enabled": true,
      "BlockedExtensions": [ "aspx", "asp", "php", "jsp", "asa", "asax", "ashx", "axd", "config" ],
      "StatusCode": 403
    },
    "IpFilter": {
      "Enabled": false,
      "Allow": [],
      "Deny": [],
      "StatusCode": 403
    },
    "RequestSize": {
      "Enabled": true,
      "MaxBytes": 10485760,
      "StatusCode": 413
    },
    "Retry": {
      "Enabled": true,
      "MaxRetries": 1,
      "RetryableStatusCodes": [ 502, 504 ],
      "RetryOnConnectionError": true,
      "RetryOnHttp500": false
    },
    "CircuitBreaker": {
      "Enabled": true,
      "FailureThreshold": 5,
      "OpenSeconds": 30,
      "HalfOpenMaxRequests": 1,
      "FailureStatusCodes": [ 500, 502, 503, 504 ],
      "StatusCode": 503
    },
    "HttpTimeout": {
      "Enabled": true,
      "ConnectSeconds": 10
    },
    "Admin": {
      "Enabled": true,
      "Path": "/admin/status",
      "ReloadEnabled": true,
      "ReloadPath": "/admin/reload"
    },
    "SecurityHeaders": {
      "Enabled": true,
      "XFrameOptions": "SAMEORIGIN",
      "XContentTypeOptions": "nosniff",
      "ReferrerPolicy": "strict-origin-when-cross-origin",
      "ContentSecurityPolicy": "",
      "XPermittedCrossDomainPolicies": "none"
    },
    "Metrics": {
      "Enabled": true,
      "MetricsPath": "/metrics",
      "HealthPath": "/health",
      "IncludePathLabels": false
    },
    "LocationRewrite": {
      "Enabled": true,
      "UseRequestHostAsPublic": true,
      "Rules": []
    },
    "ProxyLogging": {
      "Enabled": true,
      "MaxBodyBytes": 65536,
      "LogRequestHeaders": false,
      "LogRequestBody": true,
      "LogResponseBody": true,
      "IgnoreStatusCodes": [],
      "Json": false,
      "BodyLogRules": []
    }
  }
}
