<Project>

  <!--
    版本号基号（NewLife 规则：主.次.年.MDD，与 cuiwenyuan/NewLife.EFBM 一致）。
    VersionPrefix 只写「主.次」（如 1.1）；发版时由 CI 拼上 .年.MDD（如 1.1.2026.1120
    = 2026-11-20，月不补零）经 -p:Version 注入，本地无需维护，避免两处不同步。
    InformationalVersion 不显式设值，交给 SDK 自动追加 Git commit（如 1.1.2026.1120+6a44d70）。
  -->
  <PropertyGroup>
    <VersionPrefix>1.1</VersionPrefix>
    <VersionSuffix></VersionSuffix>
  </PropertyGroup>

  <!-- 程序集元数据（两项目共享） -->
  <PropertyGroup>
    <Authors>Troy Cui</Authors>
    <Company>Troy Cui</Company>
    <Product>DotNet.Yarp.Reverse.Proxy.Gateway</Product>
    <Description>.NET reverse-proxy gateway replacing nginx core on Windows Server (YARP + self-built governance)</Description>
    <RepositoryUrl>https://github.com/cuiwenyuan/DotNet.Yarp.Reverse.Proxy.Gateway</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
